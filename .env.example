# GEMINI_API_KEY: Required for Gemini AI API calls (fallback provider).
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: Primary AI provider (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# OPENMODEL_API_KEY: Second fallback AI provider (openmodel.ai)
OPENMODEL_API_KEY=
OPENMODEL_MODEL=gpt-4o

# MISTRAL_API_KEY: Third fallback AI provider (mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# PAYSTACK_PUBLIC_KEY: Required for in-app payments.
# Get yours from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY

# Supabase configuration
# Get these from your Supabase project dashboard (Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
